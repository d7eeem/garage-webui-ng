# Backend-local example environment (backend/.env, loaded by godotenv on start).
# For the deployment-level reference — Compose, volumes, image tags — see the
# root ../.env.example. Authentication is documented in ../docs/authentication.md.

BASE_PATH=""

# ── Connection to the Garage cluster ──────────────────────────────────────
API_BASE_URL="http://garage:3903"
S3_ENDPOINT_URL="http://garage:3900"
API_ADMIN_KEY=""

# Public base URL for buckets with website hosting (public read) enabled —
# route it to Garage's WEB port (garage.toml [s3_web]), never the S3 API
# port. Use {bucket} for vhost-style routing
# (https://{bucket}.web.example.com); without it the bucket becomes the
# first path segment. Leave unset to fall back to the address derived from
# garage.toml's [s3_web] root_domain.
# S3_WEB_PUBLIC_URL="https://{bucket}.web.example.com"

# Largest single file the object browser accepts, in MB. Must not exceed any
# body-size limit on a reverse proxy in front of this app.
# MAX_UPLOAD_SIZE_MB="512"

# ── User database ─────────────────────────────────────────────────────────
# Accounts live in a SQLite file, not in environment variables. This path MUST
# sit on persistent storage — losing the file loses every account and the app
# restarts at the setup wizard.
# Default: ./data/garage-webui-ng.db  (/data/garage-webui-ng.db in the image)
# DB_PATH="./data/garage-webui-ng.db"

# ── Sessions ──────────────────────────────────────────────────────────────
# Authentication is MANDATORY; there is no open mode. Against an empty database
# the app serves only the setup wizard — open the UI to create the first
# administrator, then manage accounts in Settings → Users.
SESSION_COOKIE_SECURE="false"
# Absolute session lifetime, counted from sign-in (whole hours, default 24).
# SESSION_LIFETIME_HOURS="24"
# Sign out a session left untouched for this long (whole hours, default 2).
# SESSION_IDLE_TIMEOUT_HOURS="2"

# ── Legacy accounts (import-only) ─────────────────────────────────────────
# Read EXACTLY ONCE, on the first start against an empty user database, and
# ignored forever after — the database is authoritative. Set them only to carry
# accounts over from a pre-database release (see ../docs/UPGRADING.md); editing
# them afterwards has no effect, and changing a password there will not change
# anyone's password.
# Format: 'user:bcrypt-hash', comma-separated for several accounts.
# AUTH_USER_PASS='alice:$2y$10$replace-with-your-bcrypt-hash'
# Read-only viewer accounts (same format) — can view but not modify.
# AUTH_VIEWER_USER_PASS='carol:$2y$10$replace-with-your-bcrypt-hash'
