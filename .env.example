# ─────────────────────────────────────────────────────────────────────────
# Garage WebUI-NG — example environment
# Copy to `.env` and adjust. Every value is optional unless noted; the Compose
# stack reads these via ${VAR} interpolation.
# ─────────────────────────────────────────────────────────────────────────

# ── Connection to the Garage cluster ──────────────────────────────────────
# Admin API endpoint (cluster / bucket / key management).
API_BASE_URL=http://garage:3903
# S3 API endpoint (object browse / upload / download).
S3_ENDPOINT_URL=http://garage:3900
# Public S3 endpoint the browser can reach — enables presigned share links for
# private buckets. Leave unset to disable sharing.
# S3_PUBLIC_ENDPOINT_URL=https://s3.example.com
# S3_REGION=garage

# ── Web UI runtime ────────────────────────────────────────────────────────
# Published host port (container always listens on 3909).
WEBUI_PORT=3909
# Image tag to run (e.g. latest, 2.0.0).
WEBUI_TAG=latest
# Mount the UI under a path prefix (e.g. /garage) when behind a sub-path proxy.
# BASE_PATH=

# ── Authentication (optional; when unset the UI/API are open) ──────────────
# Format: user:bcrypt-hash — multiple accounts comma-separated.
# Generate a hash:  htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n' | sed 's/^\$2y/\$2a/'
# AUTH_USER_PASS=admin:$2a$10$replace-with-your-bcrypt-hash
# Read-only viewer accounts (same format) — can view but not modify.
# AUTH_VIEWER_USER_PASS=viewer:$2a$10$replace-with-your-bcrypt-hash
# Send the session cookie only over HTTPS (set true when served behind TLS).
# SESSION_COOKIE_SECURE=true

# ── Frontend dev server only (pnpm run dev) ───────────────────────────────
# Not used by the container image; only the Vite dev server reads this.
VITE_API_URL=http://localhost:3909
