# ─────────────────────────────────────────────────────────────────────────
# Garage WebUI-NG — example environment
# Copy to `.env` and adjust. Every value is optional unless noted; the Compose
# stack reads these via ${VAR} interpolation.
# ─────────────────────────────────────────────────────────────────────────

# ── Connection to the Garage cluster ──────────────────────────────────────
# Admin API endpoint (cluster / bucket / key management).
API_BASE_URL=http://garage:3903
# S3 API endpoint (object browse / upload / download).
S3_ENDPOINT_URL=http://garage:3900
# Public S3 endpoint the browser can reach — enables presigned share links for
# private buckets. Leave unset to disable sharing.
# S3_PUBLIC_ENDPOINT_URL=https://s3.example.com
# S3_REGION=garage

# Public base URL for buckets with website hosting (public read) enabled —
# route it to Garage's WEB port (garage.toml [s3_web], Compose port 3902),
# never the S3 API port. Use {bucket} for vhost-style routing
# (https://{bucket}.web.example.com); without it the bucket becomes the first
# path segment (https://web.example.com -> https://web.example.com/mybucket).
# Leave unset to fall back to the address derived from garage.toml's
# [s3_web] root_domain.
# S3_WEB_PUBLIC_URL=https://{bucket}.web.example.com

# Largest single file the object browser accepts, in MB. Must not exceed any
# body-size limit on a reverse proxy in front of this app (nginx
# client_max_body_size, Caddy request_body max_size).
# MAX_UPLOAD_SIZE_MB=512

# ── Web UI runtime ────────────────────────────────────────────────────────
# Published host port (container always listens on 3909).
WEBUI_PORT=3909
# Image tag to run (e.g. latest, 3.1.0).
WEBUI_TAG=latest
# Mount the UI under a path prefix (e.g. /garage) when behind a sub-path proxy.
# BASE_PATH=

# ── User database ─────────────────────────────────────────────────────────
# Accounts live in a SQLite file, not in environment variables. This path MUST
# sit on a persistent volume — losing the file loses every account, and the
# app restarts at the setup wizard. The Compose stack mounts the named volume
# `webui_data` at /data for exactly this.
# Default in the container image: /data/garage-webui-ng.db
# DB_PATH=/data/garage-webui-ng.db

# ── Authentication ────────────────────────────────────────────────────────
# Authentication is MANDATORY. On a fresh deployment open the UI and follow
# the setup wizard to create the first administrator; there is no open mode.
# Accounts are managed in the UI (Settings → Users) — never here.
# Full reference: docs/authentication.md
#
# Send the session cookie only over HTTPS (set true when served behind TLS).
# SESSION_COOKIE_SECURE=true
# Absolute session lifetime, counted from sign-in (whole hours, default 24).
# SESSION_LIFETIME_HOURS=24
# Sign out a session left untouched for this long (whole hours, default 2).
# SESSION_IDLE_TIMEOUT_HOURS=2

# ── Legacy accounts (import-only) ─────────────────────────────────────────
# These two variables are read EXACTLY ONCE, on the first start against an
# empty user database, and are then ignored forever — the database is
# authoritative. Set them only to carry accounts over from a pre-database
# release; editing them afterwards has no effect (change users in the UI).
# Migrating from a pre-database release? Follow docs/UPGRADING.md.
# Format: user:bcrypt-hash — multiple accounts comma-separated.
# Generate a hash:  htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n' | sed 's/^\$2y/\$2a/'
# AUTH_USER_PASS=admin:$2a$10$replace-with-your-bcrypt-hash
# Read-only viewer accounts (same format) — can view but not modify.
# AUTH_VIEWER_USER_PASS=viewer:$2a$10$replace-with-your-bcrypt-hash

# ── Frontend dev server only (pnpm run dev) ───────────────────────────────
# Not used by the container image; only the Vite dev server reads this.
VITE_API_URL=http://localhost:3909
